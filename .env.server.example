# Copie para .env.server NO SERVIDOR (nunca commitar o .env.server real).
# Docker compose le este arquivo. ML_HEADLESS/AMAZON_HEADLESS ja vem true no compose.

# obrigatorio pra ENVIAR (id do grupo destino, ...@g.us)
WHATSAPP_GROUP_ID=

# ritmo de envio
SEND_INTERVAL_MINUTES_POOL=11,7,15
ACTIVE_HOURS_START=8
ACTIVE_HOURS_END=22

# descoberta automatica
FEED_COUNT=20
FEED_AM_HOUR=8
FEED_PM_HOUR=14

# Amazon (opcional; tag tambem editavel no painel)
AMAZON_TAG=
AMAZON_FEED_COUNT=10
