# Copie para .env e ajuste. Todas as linhas tem default sensato — o unico
# valor obrigatorio pra ENVIAR e o WHATSAPP_GROUP_ID.

# === WhatsApp (whatsapp-web.js) ===
# JID do grupo destino. Descubra com `npm run groups` (copia o ...@g.us).
WHATSAPP_GROUP_ID=
# id da sessao (so muda se rodar mais de um bot na mesma maquina)
WA_CLIENT_ID=promotion

# === Ritmo de envio ===
# minutos entre cada envio (usado so se o POOL abaixo ficar vazio)
SEND_INTERVAL_MINUTES=15
# pool de intervalos sorteado a cada envio (parece aleatorio). Vazio = fixo acima.
SEND_INTERVAL_MINUTES_POOL=11,7,15
# janela de horario ativo (24h). Ex: so envia das 8h as 22h. Use 0 e 24 pra sempre.
ACTIVE_HOURS_START=8
ACTIVE_HOURS_END=22

# === Mercado Livre (Portal do Afiliado) ===
# false = abre o Chrome visivel (precisa pra logar). Depois de logado (1x via
# `npm run ml-login`) pode por true pra rodar invisivel.
ML_HEADLESS=false

# === Descoberta automatica (feed 2x/dia) ===
# quantos produtos novos descobrir por slot (Mercado Livre)
FEED_COUNT=20
# hora do slot da manha e da tarde (24h)
FEED_AM_HOUR=8
FEED_PM_HOUR=14

# === Amazon (afiliado por tag na URL, sem login) ===
# sua tag de afiliado (xxxxx-20). VAZIO = nao posta Amazon, so ML.
AMAZON_TAG=
# quantos produtos Amazon descobrir por slot (entram no mesmo rodizio do ML)
AMAZON_FEED_COUNT=10
# Amazon nao precisa logar; true roda invisivel. Ponha false se der captcha.
AMAZON_HEADLESS=true
