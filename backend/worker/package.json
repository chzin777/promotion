{
  "name": "promotion-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "echo 'Installing browsers...' && npx puppeteer browsers install && cd node_modules/whatsapp-web.js/node_modules/puppeteer && npx puppeteer browsers install",
    "clean": "rm -rf node_modules package-lock.json && npm install && npm run setup",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "wa-login": "tsx src/wa-login.ts",
    "ml-login": "tsx src/ml-login.ts",
    "link": "tsx src/cli.ts link",
    "logout": "tsx src/cli.ts logout",
    "ml-inspect": "tsx src/ml-inspect.ts",
    "ml-generate": "tsx src/ml-generate.ts",
    "ml-links": "tsx src/ml-links.ts",
    "ml-discover": "tsx src/ml-discover.ts",
    "feed": "tsx src/ml-feed.ts",
    "status": "tsx src/cli.ts status",
    "groups": "tsx src/cli.ts groups",
    "preview": "tsx src/cli.ts preview",
    "test": "tsx src/cli.ts test"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "puppeteer": "^23.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
